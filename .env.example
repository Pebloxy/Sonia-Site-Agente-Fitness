# Copie este arquivo para ".env" e coloque a sua chave (NÃO envie o .env para o GitHub)
GEMINI_API_KEY=cole_a_chave_aqui
# Se der erro de modelo, confira o nome atual do modelo gratuito no Google AI Studio e troque aqui
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
# Voz de IA (opcional): rode "python tts/kokoro_server.py" em outro terminal. Vozes pt-BR: pf_dora, pm_alex, pm_santa
TTS_VOICE=pf_dora
