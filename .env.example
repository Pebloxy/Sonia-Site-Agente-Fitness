# Copie este arquivo para ".env" e coloque a sua chave (NÃO envie o .env para o GitHub)
GEMINI_API_KEY=cole_a_chave_aqui
# Se der erro de modelo, confira o nome atual do modelo gratuito no Google AI Studio e troque aqui
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
# Voz de IA do Gemini (usa a mesma chave acima). Para desligar e usar so a voz do navegador: GEMINI_TTS=off
GEMINI_TTS=on
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
