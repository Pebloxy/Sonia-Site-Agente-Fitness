# Copie este arquivo para ".env" e coloque a sua chave (NÃO envie o .env para o GitHub)
GEMINI_API_KEY=cole_a_chave_aqui
# Se der erro de modelo, confira o nome atual do modelo gratuito no Google AI Studio e troque aqui
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
# Voz de IA do Gemini (opcional; o plano gratis permite so 10 falas por dia). Para ligar: GEMINI_TTS=on
GEMINI_TTS=off
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# Voz neural da Microsoft (edge-tts): gratis, sem chave. Precisa de Python e "py -3.12 -m pip install edge-tts". Desligue com EDGE_TTS=off
EDGE_TTS=on
EDGE_TTS_VOICE=pt-BR-FranciscaNeural
