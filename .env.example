# =============================================
# SONIA — Variáveis de Ambiente
# =============================================
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA envie o .env para o GitHub.
# =============================================

# ----- Servidor -----
PORT=3000

# ----- Banco de Dados MySQL -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sonia_db

# ----- Google Gemini API -----
# Obtenha sua chave em: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ----- Autenticação JWT -----
# Troque por um segredo forte e único em produção
JWT_SECRET=troque_por_um_segredo_forte_aqui
JWT_EXPIRES_IN=24h

