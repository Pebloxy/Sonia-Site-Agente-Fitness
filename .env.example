# =============================================
# SONIA — Variáveis de Ambiente
# =============================================
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA envie o .env para o GitHub.
# =============================================

# ----- Servidor -----
PORT=3000

# ----- Banco de Dados MySQL -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sonia_db

# ----- Google Gemini API -----
# Obtenha sua chave em: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ----- Autenticação JWT -----
# Troque por um segredo forte e único em produção
JWT_SECRET=troque_por_um_segredo_forte_aqui
JWT_EXPIRES_IN=24h

# ----- Configurações Opcionais de Voz (TTS) -----
# Voz de IA do Gemini (opcional; o plano grátis permite só 10 falas por dia): GEMINI_TTS=on
GEMINI_TTS=off
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Voz neural Edge-TTS (grátis, opcional; requer Python e pip install edge-tts): EDGE_TTS=off para desativar
EDGE_TTS=on
EDGE_TTS_VOICE=pt-BR-FranciscaNeural
